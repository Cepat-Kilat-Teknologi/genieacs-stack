# GenieACS Docker Configuration - NBI Authentication
# ===================================================
# Copy to .env and configure before deployment
# cp .env.example .env

# ===========================================
# REQUIRED - Security Settings
# ===========================================

# JWT Secret for UI authentication (REQUIRED)
# Generate with: openssl rand -hex 32
GENIEACS_UI_JWT_SECRET=

# API Key for NBI authentication (REQUIRED)
# Generate with: openssl rand -hex 32
GENIEACS_NBI_API_KEY=

# Enable UI authentication
GENIEACS_UI_AUTH=true

# Credentials for the initial admin user created by `make create-user`.
# These are only read by the provisioning script -- they are NOT baked into
# the running GenieACS container.
GENIEACS_ADMIN_USERNAME=admin
GENIEACS_ADMIN_PASSWORD=REPLACE_ME--strong-password

# ===========================================
# REQUIRED - MongoDB Authentication
# ===========================================

# MongoDB root username
MONGO_INITDB_ROOT_USERNAME=admin

# MongoDB root password (REQUIRED)
# Generate with: openssl rand -base64 24
MONGO_INITDB_ROOT_PASSWORD=

# MongoDB connection URL (must match credentials above)
# Update password in URL after setting MONGO_INITDB_ROOT_PASSWORD
GENIEACS_MONGODB_CONNECTION_URL=mongodb://admin:YOUR_PASSWORD_HERE@mongo:27017/genieacs?authSource=admin

# ===========================================
# Network Configuration
# ===========================================

# Service ports -- by default these bind to all interfaces (0.0.0.0).
# To restrict access to a specific IP, prefix the port:
#   GENIEACS_UI_PORT=192.168.1.10:3000
# The create-user.sh script handles both formats automatically.
GENIEACS_CWMP_PORT=7547
GENIEACS_NBI_PORT=7557
GENIEACS_FS_PORT=7567
GENIEACS_UI_PORT=3000

# ===========================================
# Optional: Bind to localhost only
# ===========================================
# If using reverse proxy (nginx/traefik):
# GENIEACS_CWMP_PORT=127.0.0.1:7547
# GENIEACS_NBI_PORT=127.0.0.1:7557
# GENIEACS_FS_PORT=127.0.0.1:7567
# GENIEACS_UI_PORT=127.0.0.1:3000